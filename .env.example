# Supabase — get from supabase.com → your project → Settings → API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Stripe — get from dashboard.stripe.com → Developers → API keys
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your-key-here

# Stripe Price IDs — create products in Stripe dashboard first
# Starter: $7.49 CAD/month recurring
VITE_STRIPE_STARTER_PRICE_ID=price_starter_id_here
# Pro: $12.99 CAD/month recurring
VITE_STRIPE_PRO_PRICE_ID=price_pro_id_here

# Your app URL (used for Stripe redirect after checkout)
VITE_APP_URL=http://localhost:5173

# Support form email delivery (Supabase Edge Function secrets)
# Set these with: supabase secrets set RESEND_API_KEY=... SUPPORT_EMAIL=... RESEND_FROM_EMAIL=...
RESEND_API_KEY=re_your-key-here
SUPPORT_EMAIL=support@stubdesk.ca
RESEND_FROM_EMAIL=StubDesk Support <support@stubdesk.ca>
